---
import { WHATSAPP_NUMBER, WHATSAPP_MESSAGE } from '../../data/draft';

interface Props {
  label?: string;
  class?: string;
}

const { label = 'Escribinos por WhatsApp', class: className = '' } = Astro.props;
const href = WHATSAPP_NUMBER
  ? `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WHATSAPP_MESSAGE)}`
  : '#';
---

<a href={href} class={className} {...(WHATSAPP_NUMBER ? { target: '_blank', rel: 'noopener' } : {})}>
  <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm0 18.2a8.2 8.2 0 01-4.2-1.15l-.3-.18-3 .78.8-2.9-.2-.3A8.2 8.2 0 1112 20.2zm4.5-6.1c-.25-.12-1.45-.72-1.68-.8-.22-.08-.39-.12-.55.12-.16.25-.63.8-.77.96-.14.17-.28.18-.53.06a6.7 6.7 0 01-3.3-2.9c-.25-.43.25-.4.72-1.33.08-.16.04-.3-.02-.42-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.43.06-.65.3-.22.25-.86.84-.86 2.05s.88 2.38 1 2.55c.12.16 1.73 2.64 4.2 3.7 1.55.67 2.15.73 2.93.62.47-.07 1.45-.6 1.66-1.17.2-.58.2-1.07.14-1.17-.06-.1-.22-.16-.47-.28z"/>
  </svg>
  {label}
  {!WHATSAPP_NUMBER && <span class="ml-1 text-xs font-semibold opacity-90">[FALTA: número]</span>}
</a>
