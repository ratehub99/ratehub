---
import { services, CONTACT_EMAIL } from '../../data/site';
import DsContactForm from './DsContactForm.astro';

// Grilla suiza de 8 cuadrados: 4 con texto y 4 vacíos (solo la cuadrícula tenue del hero),
// alternados en diagonal para repartir el peso visual. Solo tipografía, sin ilustraciones.
const byId = Object.fromEntries(services.map((s) => [s.id, s]));
// Orden de lectura de la grilla (4 columnas × 2 filas). 'empty' = cuadrado vacío.
const cells = [
  { type: 'text', id: 'sitio' },
  { type: 'empty' },
  { type: 'empty' },
  { type: 'text', id: 'medicion' },
  { type: 'empty' },
  { type: 'text', id: 'comercial' },
  { type: 'text', id: 'automatizacion' },
  { type: 'empty' },
] as const;
---

{/* BORRADOR de copy generado con IA: pendiente de revisión humana. Los textos viven en src/data/site.ts. */}
<section id="servicios" class="scroll-mt-16" style="box-shadow: 0 -1px 0 var(--border)">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6 py-24 md:py-40">
    <h2 class="h2 max-w-[20ch] reveal">Lo que hacemos por tu negocio.</h2>

    <ul class="swiss mt-16 reveal">
      {cells.map((c) => c.type === 'text' ? (
        <li class="swiss-cell swiss-text">
          <h3 class="text-[24px] leading-8 font-medium tracking-[-0.03em]">{byId[c.id].title}</h3>
          <p class="text-[16px] leading-6 text-fg-muted">{byId[c.id].desc}</p>
        </li>
      ) : (
        <li class="swiss-cell swiss-empty" aria-hidden="true"></li>
      ))}
    </ul>
  </div>
</section>

<section id="contacto" class="scroll-mt-16" style="box-shadow: 0 -1px 0 var(--border)">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6 py-24 md:py-40 text-center">
    <h2 class="h2 max-w-[22ch] mx-auto reveal">Contanos de tu negocio.</h2>
    <DsContactForm />
    <p class="mt-16 text-fg-muted reveal">
      También podés escribirnos por mail a <a href={`mailto:${CONTACT_EMAIL}`} class="text-fg underline underline-offset-4">{CONTACT_EMAIL}</a>
    </p>
  </div>
</section>

<style is:global>
  /* Grilla suiza: líneas de 1px compartidas (gap + fondo), cuadrados a partir de lg. */
  .ds .swiss { display: grid; grid-template-columns: 1fr; gap: 1px; background: var(--border); box-shadow: 0 0 0 1px var(--border); list-style: none; padding: 0; }
  .ds .swiss-cell { background: var(--bg); min-width: 0; }
  .ds .swiss-text { display: flex; flex-direction: column; justify-content: space-between; gap: 24px; padding: 28px 24px; }
  .ds .swiss-empty { display: none;
    background-image: linear-gradient(to right, var(--grid-line) 1px, transparent 1px), linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 64px 64px; background-position: center; }
  @media (min-width: 640px) {
    .ds .swiss { grid-template-columns: repeat(2, 1fr); }
    .ds .swiss-empty { display: block; }
    .ds .swiss-cell { aspect-ratio: 1; }
  }
  @media (min-width: 1024px) {
    .ds .swiss { grid-template-columns: repeat(4, 1fr); }
    .ds .swiss-text { padding: 24px 20px; }
  }
</style>
