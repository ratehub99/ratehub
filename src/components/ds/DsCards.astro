---
import { services, CONTACT_EMAIL } from '../../data/site';
import { whatsappLinkAttrs } from '../../lib/contact';

// Ilustraciones abstractas de línea fina (decorativas).
const art: Record<string, string> = {
  sitio: `<rect x="40" y="18" width="240" height="104" rx="8"/><path d="M40 42h240"/><circle cx="54" cy="30" r="2"/><circle cx="64" cy="30" r="2"/><path d="M60 62h100M60 76h140M60 90h80"/><rect x="200" y="60" width="64" height="44" rx="4"/>`,
  medicion: `<path d="M40 120V24M40 120h240"/><path d="M52 98l44-24 40 14 48-48 56 20"/><circle cx="96" cy="74" r="3"/><circle cx="136" cy="88" r="3"/><circle cx="184" cy="40" r="3"/>`,
  comercial: `<rect x="30" y="28" width="96" height="16" rx="4"/><rect x="30" y="54" width="96" height="16" rx="4"/><rect x="30" y="80" width="56" height="20" rx="10"/><path d="M142 64h30m-6-6l6 6-6 6"/><rect x="186" y="28" width="104" height="92" rx="6"/><path d="M186 52h104M186 76h104M186 100h104"/>`,
  automatizacion: `<rect x="30" y="50" width="64" height="40" rx="6"/><rect x="128" y="22" width="64" height="40" rx="6"/><rect x="128" y="80" width="64" height="40" rx="6"/><rect x="226" y="50" width="64" height="40" rx="6"/><path d="M94 70h12v-28h22M94 70h12v30h22M192 42h12v28h22M192 100h12V70h22"/>`,
};
---

{/* BORRADOR de copy generado con IA: pendiente de revisión humana. Los textos viven en src/data/site.ts. */}
<section id="servicios"class="scroll-mt-16" style="box-shadow: 0 -1px 0 var(--border)">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6 py-24 md:py-40">
    <p class="eyebrow mb-6 reveal">Servicios</p>
    <h2 class="h2 max-w-[20ch] reveal">Lo que hacemos por tu negocio.</h2>

    <ul class="mt-16 grid gap-6 md:grid-cols-2">
      {services.map((s) => (
        <li class="rounded-xl bg-bg-2 hair overflow-hidden flex flex-col reveal">
          <div class="h-[168px] flex items-center justify-center text-fg-subtle" style="box-shadow: 0 1px 0 var(--border); background-image: linear-gradient(to right, var(--grid-line) 1px, transparent 1px), linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px); background-size: 32px 32px">
            <svg viewBox="0 0 320 140" class="w-full max-w-[320px] h-auto" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true" set:html={art[s.id]} />
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <h3 class="text-[24px] leading-8 font-medium tracking-[-0.03em]">{s.title}</h3>
            <p class="mt-3 text-fg-muted">{s.desc}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<section id="contacto" class="scroll-mt-16" style="box-shadow: 0 -1px 0 var(--border)">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6 py-24 md:py-40 text-center">
    <h2 class="h2 max-w-[22ch] mx-auto reveal">Contanos de tu negocio.</h2>
    <div class="mt-10 reveal">
      <a {...whatsappLinkAttrs} class="btn btn-primary">Escribinos por WhatsApp</a>
    </div>
    <p class="mt-6 text-fg-muted reveal">
      O por mail a <a href={`mailto:${CONTACT_EMAIL}`} class="text-fg underline underline-offset-4">{CONTACT_EMAIL}</a>
    </p>
  </div>
</section>
