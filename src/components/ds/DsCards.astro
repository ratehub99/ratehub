---
import { steps, whatsappHref } from '../../data/draft';

// Ilustraciones abstractas de línea fina (decorativas).
const art: Record<string, string> = {
  '1': `<rect x="40" y="18" width="240" height="104" rx="8"/><path d="M40 42h240"/><circle cx="54" cy="30" r="2"/><circle cx="64" cy="30" r="2"/><path d="M60 62h100M60 76h140M60 90h80"/><rect x="200" y="60" width="64" height="44" rx="4"/>`,
  '2': `<path d="M40 120V24M40 120h240"/><path d="M52 98l44-24 40 14 48-48 56 20"/><circle cx="96" cy="74" r="3"/><circle cx="136" cy="88" r="3"/><circle cx="184" cy="40" r="3"/>`,
  '3': `<rect x="30" y="28" width="96" height="16" rx="4"/><rect x="30" y="54" width="96" height="16" rx="4"/><rect x="30" y="80" width="56" height="20" rx="10"/><path d="M142 64h30m-6-6l6 6-6 6"/><rect x="186" y="28" width="104" height="92" rx="6"/><path d="M186 52h104M186 76h104M186 100h104"/>`,
  '4': `<rect x="30" y="50" width="64" height="40" rx="6"/><rect x="128" y="22" width="64" height="40" rx="6"/><rect x="128" y="80" width="64" height="40" rx="6"/><rect x="226" y="50" width="64" height="40" rx="6"/><path d="M94 70h12v-28h22M94 70h12v30h22M192 42h12v28h22M192 100h12V70h22"/>`,
  '5': `<path d="M110 54a50 50 0 0188 6M210 86a50 50 0 01-88-6"/><path d="M192 44l8 16-17 3M128 96l-8-16 17-3"/><path d="M40 118h240" stroke-dasharray="2 6"/>`,
};
---

<section id="camino" class="scroll-mt-16" style="box-shadow: 0 -1px 0 var(--border)">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6 py-24 md:py-40">
    <p class="eyebrow mb-6 reveal">Servicios</p>
    <h2 class="h2 max-w-[20ch] reveal">El camino, paso a paso.</h2>
    <p class="lead max-w-[36ch] mt-6 reveal">Empezás por el sitio y sumás lo que tu negocio necesite, cuando lo necesite.</p>

    <ol class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-6">
      {steps.map((s, i) => (
        <li class:list={['rounded-xl bg-bg-2 hair overflow-hidden flex flex-col reveal', i < 3 ? 'lg:col-span-2' : 'lg:col-span-3']}>
          <div class="h-[168px] flex items-center justify-center text-fg-subtle" style="box-shadow: 0 1px 0 var(--border); background-image: linear-gradient(to right, var(--grid-line) 1px, transparent 1px), linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px); background-size: 32px 32px">
            <svg viewBox="0 0 320 140" class="w-full max-w-[320px] h-auto" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true" set:html={art[s.n]} />
          </div>
          <div class="p-6 flex-1">
            <p class="eyebrow flex items-center gap-2">
              Etapa 0{s.n}
              {i === 0 && (
                <span class="inline-flex items-center gap-1.5 normal-case tracking-normal text-fg">
                  <span class="w-1.5 h-1.5 rounded-full" style="background: var(--blue)" aria-hidden="true"></span>empezás acá
                </span>
              )}
            </p>
            <h3 class="mt-3 text-[24px] leading-8 font-medium tracking-[-0.03em]">{s.title}</h3>
            <p class="mt-2 text-fg-muted">{s.desc}</p>
            {s.missing && (
              <p class="mt-4">
                <span class="inline-block rounded px-2 py-1 text-[14px] leading-5 font-medium bg-state-amber-bg" style="color: var(--amber-fg)">[{s.missing}]</span>
              </p>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section id="contacto" class="scroll-mt-16" style="box-shadow: 0 -1px 0 var(--border)">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6 py-24 md:py-40 text-center">
    <h2 class="h2 max-w-[22ch] mx-auto reveal">Contanos de tu negocio.</h2>
    <p class="lead mt-6 reveal">Vemos si podemos ayudarte.</p>
    <div class="mt-10 reveal">
      <a href={whatsappHref} target="_blank" rel="noopener" class="btn btn-primary">Escribinos por WhatsApp</a>
    </div>
  </div>
</section>
