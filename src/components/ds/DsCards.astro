---
import { services, CONTACT_EMAIL } from '../../data/site';
import DsContactForm from './DsContactForm.astro';

// Grilla suiza de 5 columnas × 2 filas: un cuadrado con texto, uno vacío (sin trama), alternados en damero.
// Todos los textos van alineados arriba de su cuadrado. Solo tipografía, sin ilustraciones.
const cells = services.flatMap((s) => [{ type: 'text' as const, s }, { type: 'empty' as const }]);
---

{/* BORRADOR de copy generado con IA: pendiente de revisión humana. Los textos viven en src/data/site.ts. */}
<section id="servicios" class="scroll-mt-16 overflow-x-clip" style="box-shadow: 0 -1px 0 var(--border)">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6 py-24 md:py-40">
    <h2 class="h2 max-w-[20ch] reveal">Servicios.</h2>

    <div class="swiss-wrap mt-16 reveal">
    <div class="swiss-vlines" aria-hidden="true"></div>
    <span class="swiss-hline" style="top: 0" aria-hidden="true"></span>
    <span class="swiss-hline" style="top: 50%" aria-hidden="true"></span>
    <ul class="swiss">
      {cells.map((c) => c.type === 'text' ? (
        <li class="swiss-cell swiss-text">
          <h3 class="text-[24px] leading-8 font-medium tracking-[-0.03em]">{c.s.title}</h3>
          <p class="text-[16px] leading-6 text-fg-muted">{c.s.desc}</p>
        </li>
      ) : (
        <li class="swiss-cell swiss-empty" aria-hidden="true"></li>
      ))}
    </ul>
    </div>
  </div>
</section>

<section id="contacto" class="scroll-mt-16" style="box-shadow: 0 -1px 0 var(--border)">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6 py-24 md:py-40 text-center">
    <h2 class="h2 max-w-[22ch] mx-auto reveal">Contanos de tu negocio.</h2>
    <DsContactForm />
    <p class="mt-16 text-fg-muted reveal">
      También podés escribirnos por mail a <a href={`mailto:${CONTACT_EMAIL}`} class="text-fg underline underline-offset-4">{CONTACT_EMAIL}</a>
    </p>
  </div>
</section>

<style is:global>
  /* Grilla suiza. Menos de lg: cuadros con líneas compartidas. Desde lg: las horizontales corren de borde a borde
     de la pantalla y las verticales se difuminan hacia el título y hacia la sección siguiente. */
  .ds .swiss-wrap { position: relative; }
  .ds .swiss-vlines, .ds .swiss-hline { display: none; }
  .ds .swiss { display: grid; grid-template-columns: 1fr; gap: 1px; background: var(--border); box-shadow: 0 0 0 1px var(--border); list-style: none; padding: 0; position: relative; }
  .ds .swiss-cell { background: var(--bg); min-width: 0; }
  .ds .swiss-text { display: flex; flex-direction: column; gap: 12px; padding: 28px 24px; }
  .ds .swiss-empty { display: none; }
  @media (min-width: 640px) {
    .ds .swiss { grid-template-columns: repeat(2, 1fr); }
    .ds .swiss-empty { display: block; }
    .ds .swiss-cell { aspect-ratio: 1; }
  }
  @media (min-width: 1024px) {
    .ds .swiss { grid-template-columns: repeat(5, 1fr); gap: 0; background: none; box-shadow: none; }
    .ds .swiss-cell { background-color: transparent; }
    .ds .swiss-text { padding: 24px 20px; }
    .ds .swiss-vlines, .ds .swiss-hline { display: block; position: absolute; pointer-events: none; }
    .ds .swiss-hline { left: 50%; width: 100vw; margin-left: -50vw; height: 1px; background: var(--border); }
    .ds .swiss-vlines {
      left: 0; right: 0; top: -56px; bottom: -120px; box-sizing: border-box; border-right: 1px solid var(--border);
      background-image: linear-gradient(to right, var(--border) 1px, transparent 1px); background-size: 20% 100%;
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 56px, #000 calc(100% - 120px), transparent);
      mask-image: linear-gradient(to bottom, transparent, #000 56px, #000 calc(100% - 120px), transparent);
    }
  }
</style>
