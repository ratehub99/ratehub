---
import { whatsappHref } from '../../data/draft';

const links = [
  { href: '/#conectado', label: 'Qué hacemos' },
  { href: '/#camino', label: 'El camino' },
  { href: '/#contacto', label: 'Contacto' },
];
---

<header class="sticky top-0 z-50 h-16 bg-bg/80 backdrop-blur-md" style="box-shadow: 0 1px 0 var(--border)">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6 h-full flex items-center gap-8">
    <a href="/" class="flex items-center gap-2 font-medium tracking-tight text-[18px]" aria-label="RateHub">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <rect x="1" y="1" width="16" height="16" rx="4" stroke="currentColor" stroke-width="1.5" />
        <circle cx="12" cy="6" r="2" fill="currentColor" />
      </svg>
      RateHub
    </a>

    <nav class="hidden md:flex items-center gap-6 text-[14px] leading-5 text-fg-muted" aria-label="Principal">
      {links.map((l) => <a href={l.href} class="hover:text-fg transition-colors duration-150">{l.label}</a>)}
    </nav>

    <div class="ml-auto hidden md:flex items-center gap-4">
      <a href="/#camino" class="text-[14px] text-fg-muted hover:text-fg transition-colors duration-150">Ver el camino</a>
      <a href={whatsappHref} target="_blank" rel="noopener" class="btn btn-primary btn-sm">WhatsApp</a>
    </div>

    <button
      id="ds-menu-btn"
      type="button"
      class="md:hidden ml-auto w-10 h-10 flex items-center justify-center rounded-none"
      aria-controls="ds-menu"
      aria-expanded="false"
      aria-label="Abrir menú"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M3 7h14M3 13h14" />
      </svg>
    </button>
  </div>

  <div id="ds-menu" hidden class="md:hidden bg-bg" style="box-shadow: 0 1px 0 var(--border)">
    <nav class="px-4 py-3 flex flex-col" aria-label="Móvil">
      {links.map((l) => <a href={l.href} class="py-3 text-[16px] text-fg-muted hover:text-fg">{l.label}</a>)}
      <a href={whatsappHref} target="_blank" rel="noopener" class="btn btn-primary my-2">Escribinos por WhatsApp</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('ds-menu-btn');
  const menu = document.getElementById('ds-menu');
  const setOpen = (open: boolean) => {
    if (!btn || !menu) return;
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  };
  btn?.addEventListener('click', () => setOpen(menu?.hidden ?? false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
