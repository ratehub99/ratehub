---
const year = new Date().getFullYear();
const cols = [
  {
    title: 'Servicios',
    links: [
      { label: 'Sitio web', href: '#camino' },
      { label: 'Medición y orden', href: '#camino' },
      { label: 'Gestión comercial', href: '#camino' },
      { label: 'Automatización', href: '#camino' },
      { label: 'Acompañamiento', href: '#camino' },
    ],
  },
  {
    title: 'Estudio',
    links: [
      { label: 'Qué hacemos', href: '#conectado' },
      { label: 'El camino', href: '#camino' },
      { label: 'Contacto', href: '#contacto' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Política de privacidad', href: '/privacidad' },
      { label: 'Términos de servicio', href: '/terminos' },
    ],
  },
  {
    title: 'Contacto',
    links: [
      { label: 'WhatsApp', href: 'https://wa.me/5491144169746' },
      { label: 'hola@ratehub.com.ar', href: 'mailto:hola@ratehub.com.ar' },
    ],
  },
];
const themes = [
  { id: 'system', label: 'Sistema' },
  { id: 'light', label: 'Claro' },
  { id: 'dark', label: 'Oscuro' },
];
---

<footer style="box-shadow: 0 -1px 0 var(--border)">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6 pt-16 pb-10">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-x-6 gap-y-10">
      <div class="col-span-2 md:col-span-1">
        <p class="text-[14px] leading-5 font-medium">RateHub</p>
        <p class="mt-3 text-[14px] leading-5 text-fg-muted max-w-[24ch]">Estudio de diseño y desarrollo web. Argentina.</p>
      </div>
      {cols.map((c) => (
        <nav aria-label={c.title}>
          <h3 class="text-[14px] leading-5 font-medium">{c.title}</h3>
          <ul class="mt-4 space-y-3">
            {c.links.map((l) => (
              <li><a href={l.href} class="text-[14px] leading-5 text-fg-muted hover:text-fg transition-colors duration-150">{l.label}</a></li>
            ))}
          </ul>
          {c.title === 'Legal' && (
            <p class="mt-4 text-[12px] leading-4 text-fg-muted max-w-[22ch]">Borrador pendiente de revisión legal.</p>
          )}
          {c.title === 'Contacto' && (
            <p class="mt-4"><span class="inline-block rounded px-1.5 py-0.5 text-[12px] leading-4 font-medium bg-state-amber-bg" style="color: var(--amber-fg)">[FALTA: redes]</span></p>
          )}
        </nav>
      ))}
    </div>

    <div class="mt-16 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6">
        <p class="text-[14px] leading-5 text-fg-muted">© {year} RateHub</p>
        <p class="eyebrow flex items-center gap-2 text-fg">
          <span class="w-2 h-2 rounded-full" style="background: var(--blue)" aria-hidden="true"></span>Pre-lanzamiento
        </p>
      </div>

      <div role="group" aria-label="Tema" class="inline-flex rounded-full p-0.5 hair self-start">
        {themes.map((t) => (
          <button type="button" data-theme-set={t.id} aria-pressed="false" class="ds-theme h-8 px-3 rounded-full text-[13px] font-medium text-fg-muted">{t.label}</button>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .ds-theme { transition: background-color 150ms ease-out, color 150ms ease-out; }
  .ds-theme:hover { color: var(--fg); }
  .ds-theme[aria-pressed='true'] { background: var(--bg-2); color: var(--fg); box-shadow: 0 0 0 1px var(--border-strong); }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-set]');
  const root = document.documentElement;
  const apply = (t: string) => {
    const dark = t === 'dark' || (t === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
    root.classList.toggle('dark', dark);
    root.dataset.theme = t;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeSet === t)));
  };
  apply(root.dataset.theme ?? 'light');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const t = b.dataset.themeSet ?? 'light';
      try { localStorage.setItem('rh-theme', t); } catch {}
      apply(t);
    }),
  );
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (root.dataset.theme === 'system') apply('system');
  });
</script>
