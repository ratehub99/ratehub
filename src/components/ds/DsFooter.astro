---
import { CONTACT_EMAIL } from '../../data/site';
import { whatsappHref } from '../../lib/contact';

const year = new Date().getFullYear();
const cols = [
  {
    title: 'Servicios',
    links: [
      { label: 'Sitio web', href: '/#servicios' },
      { label: 'Hosting y mantenimiento', href: '/#servicios' },
      { label: 'Gestión comercial', href: '/#servicios' },
      { label: 'Automatización y visibilidad', href: '/#servicios' },
      { label: 'Medición y orden', href: '/#servicios' },
    ],
  },
  {
    title: 'Estudio',
    links: [
      { label: 'Servicios', href: '/#servicios' },
      { label: 'Contacto', href: '/#contacto' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Política de privacidad', href: '/privacidad' },
      { label: 'Términos de servicio', href: '/terminos' },
    ],
  },
  {
    title: 'Contacto',
    links: [
      { label: 'WhatsApp', href: whatsappHref, external: true },
      { label: CONTACT_EMAIL, href: `mailto:${CONTACT_EMAIL}` },
    ],
  },
];
// Íconos de 16px (trazo 1.5). Solo ícono: el nombre va en aria-label y title.
const themes = [
  { id: 'system', label: 'Tema del sistema', icon: '<rect x="2" y="3" width="12" height="8" rx="1"/><path d="M5.5 14h5M8 11v3"/>' },
  { id: 'light', label: 'Tema claro', icon: '<circle cx="8" cy="8" r="2.75"/><path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1 1M11.6 11.6l1 1M3.4 12.6l1-1M11.6 4.4l1-1"/>' },
  { id: 'dark', label: 'Tema oscuro', icon: '<path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7z"/>' },
];
---

<footer style="box-shadow: 0 -1px 0 var(--border)">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6 pt-16 pb-10">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-x-6 gap-y-10">
      <div class="col-span-2 md:col-span-1">
        <p class="text-[14px] leading-5 font-medium">RateHub</p>
        <p class="mt-3 text-[14px] leading-5 text-fg-muted max-w-[24ch]">Sitios web, CRM, automatizaciones y más. Argentina.</p>
      </div>
      {cols.map((c) => (
        <nav aria-label={c.title}>
          <h3 class="text-[14px] leading-5 font-medium">{c.title}</h3>
          <ul class="mt-4 space-y-3">
            {c.links.map((l) => (
              <li><a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener noreferrer', 'aria-label': 'Escribinos por WhatsApp (se abre en una pestaña nueva)' } : {})} class="text-[14px] leading-5 text-fg-muted hover:text-fg transition-colors duration-150">{l.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="mt-16 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <p class="text-[14px] leading-5 text-fg-muted">© {year} RateHub</p>

      <div role="group" aria-label="Tema" class="ds-themes self-start">
        {themes.map((t) => (
          <button type="button" data-theme-set={t.id} aria-pressed="false" aria-label={t.label} title={t.label} class="ds-theme">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.icon}></svg>
          </button>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .ds-themes { display: inline-flex; gap: 2px; padding: 3px; border-radius: 9999px; box-shadow: 0 0 0 1px var(--border-strong); }
  .ds-theme { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 9999px; color: var(--fg-muted); transition: background-color 150ms ease-out, color 150ms ease-out; }
  .ds-theme:hover { color: var(--fg); }
  .ds-theme[aria-pressed='true'] { background: var(--fg); color: var(--bg); }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-set]');
  const root = document.documentElement;
  const apply = (t: string) => {
    const dark = t === 'dark' || (t === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
    root.classList.toggle('dark', dark);
    root.dataset.theme = t;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeSet === t)));
  };
  apply(root.dataset.theme ?? 'light');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const t = b.dataset.themeSet ?? 'light';
      try { localStorage.setItem('rh-theme', t); } catch {}
      apply(t);
    }),
  );
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (root.dataset.theme === 'system') apply('system');
  });
</script>
