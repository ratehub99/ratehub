---
import { whatsappHref } from '../../data/draft';

// Capacidades propias (no clientes). Los logos de clientes reemplazan esta tira
// solo cuando haya autorización escrita.
const items = [
  'Diseño web', 'Medición', 'CRM', 'Formularios conectados',
  'Email marketing', 'Automatizaciones', 'Dashboards', 'Hosting y mantenimiento',
];
---

<section class="relative overflow-hidden">
  <div class="hero-bg absolute inset-0" aria-hidden="true"></div>
  <div class="relative max-w-[1200px] mx-auto px-4 md:px-6 pt-24 md:pt-40 pb-20 md:pb-28 text-center">
    <h1 class="h1 max-w-[18ch] mx-auto reveal">Tu sitio web, conectado a tu negocio.</h1>
    <p class="eyebrow mt-8 reveal">Diseño · datos · automatización — estudio en Argentina</p>
    <div class="mt-10 flex flex-col sm:flex-row gap-3 justify-center reveal">
      <a href={whatsappHref} target="_blank" rel="noopener" class="btn btn-primary">Escribinos por WhatsApp</a>
      <a href="#camino" class="btn btn-secondary">Ver el camino</a>
    </div>
    <p class="mt-5 text-[14px] leading-5 text-fg-muted reveal">Contanos de tu negocio y vemos si podemos ayudarte.</p>
  </div>

  <div class="relative pb-20 md:pb-28">
    <p class="eyebrow text-center mb-8">Lo que conectamos a tu sitio</p>
    <div class="marquee" role="list" aria-label="Capacidades del estudio">
      <div class="marquee-track">
        {[0, 1].map((copy) => (
          <div class="flex shrink-0" aria-hidden={copy === 1 ? 'true' : undefined}>
            {items.map((t) => (
              <span role={copy === 0 ? 'listitem' : undefined} class="flex items-center gap-10 pr-10 text-[20px] leading-7 font-medium tracking-tight text-fg-muted whitespace-nowrap">
                {t}<span class="w-1 h-1 rounded-full bg-fg-subtle" aria-hidden="true"></span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
    <p class="mt-8 text-center">
      <span class="inline-block rounded px-2 py-1 text-[14px] leading-5 font-medium bg-state-amber-bg" style="color: var(--amber-fg)">
        [FALTA: logos de clientes autorizados por escrito — reemplazan esta tira]
      </span>
    </p>
  </div>
</section>
