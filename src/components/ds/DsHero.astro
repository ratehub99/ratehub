---
import DsLogos from './DsLogos.astro';
---

<section class="relative overflow-hidden">
  <div class="hero-bg absolute inset-0" aria-hidden="true"></div>
  <div class="relative max-w-[1200px] mx-auto px-4 md:px-6 pt-24 md:pt-40 pb-12 md:pb-16 text-center">
    <h1 class="h1 max-w-[18ch] mx-auto reveal">Construimos los sistemas que tu negocio necesita.</h1>
    <p class="lead mt-8 reveal">Sitios web, CRM, automatizaciones y más.</p>
    <div class="mt-10 flex flex-col sm:flex-row gap-3 justify-center reveal">
      <a href="#contacto" class="btn btn-primary">Charlemos</a>
      <a href="#servicios" class="btn btn-secondary">Ver servicios</a>
    </div>
  </div>

  <DsLogos />
</section>
