---
// Propuesta 3: "Monocromo". Blanco y negro, líneas finas, tipografía firme.
// BORRADOR generado con IA. Inspiración de principios (no se copian layouts ni assets).
import Draft from '../../layouts/Draft.astro';
import WhatsAppCta from '../../components/draft/WhatsAppCta.astro';
import { steps } from '../../data/draft';

const cta =
  'inline-flex items-center justify-center gap-3 min-h-[60px] px-8 rounded-md bg-black hover:bg-[#333] text-white text-lg font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black';
---

<Draft title="Propuesta 3 · Monocromo — RateHub" bodyClass="bg-white text-black font-sans-draft text-lg leading-relaxed antialiased">
  <header class="border-b border-[#EAEAEA]">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between">
      <a href="/propuestas" class="text-xl font-bold tracking-tight">RateHub</a>
      <WhatsAppCta
        label="WhatsApp"
        class="hidden sm:inline-flex items-center gap-2 min-h-[44px] px-4 rounded-md border border-black font-semibold hover:bg-black hover:text-white transition-colors"
      />
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="border-b border-[#EAEAEA]">
      <div class="max-w-6xl mx-auto px-5 sm:px-8 pt-16 pb-20 sm:pt-28 sm:pb-32">
        <p class="font-mono-draft text-sm uppercase tracking-wider text-[#4D4D4D] mb-6">
          Estudio de diseño y desarrollo web · Argentina
        </p>
        <h1 class="text-[2.6rem] sm:text-7xl font-bold tracking-[-0.045em] leading-[1.02] max-w-4xl mb-8">
          Un sitio web conectado a tu negocio, no un folleto en internet.
        </h1>
        <p class="text-xl sm:text-2xl text-[#4D4D4D] max-w-2xl mb-10 leading-snug">
          Diseño y marketing con base técnica en datos. Empezamos por tu sitio y, si lo necesitás, seguimos: medir, ordenar y automatizar.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 sm:items-center">
          <WhatsAppCta class={cta} />
          <a href="#camino" class="inline-flex items-center min-h-[60px] px-2 text-lg font-semibold underline underline-offset-4 decoration-2 hover:no-underline">
            Ver cómo trabajamos
          </a>
        </div>
        <p class="mt-5 text-base text-[#4D4D4D]">Contanos de tu negocio y vemos si podemos ayudarte.</p>
      </div>
    </section>

    <!-- SERVICIOS: escalera como camino -->
    <section id="camino" class="scroll-mt-4">
      <div class="max-w-6xl mx-auto px-5 sm:px-8 py-20 sm:py-28">
        <div class="grid lg:grid-cols-[1fr_1.6fr] gap-12 lg:gap-20">
          <div class="lg:sticky lg:top-8 self-start">
            <p class="font-mono-draft text-sm uppercase tracking-wider text-[#4D4D4D] mb-4">El camino</p>
            <h2 class="text-4xl sm:text-5xl font-bold tracking-[-0.04em] leading-[1.05] mb-5">Un paso por vez.</h2>
            <p class="text-xl text-[#4D4D4D] leading-snug mb-8">
              Empezás por el sitio y sumás lo que tu negocio necesite, cuando lo necesite.
            </p>
            <WhatsAppCta class={cta} />
          </div>

          <ol class="border border-black">
            {steps.map((s, i) => (
              <li class:list={['grid grid-cols-[4.5rem_1fr] sm:grid-cols-[5.5rem_1fr]', i > 0 && 'border-t border-[#EAEAEA]']}>
                <div class="border-r border-[#EAEAEA] flex flex-col items-center pt-7 bg-[#FAFAFA]">
                  <span class="font-mono-draft text-sm text-[#4D4D4D]" aria-hidden="true">PASO</span>
                  <span class="text-4xl font-bold tracking-tighter leading-none mt-1" aria-hidden="true">0{s.n}</span>
                  {i < steps.length - 1 && <span class="mt-4 text-xl" aria-hidden="true">↓</span>}
                </div>
                <div class="p-6 sm:p-8">
                  {i === 0 && <p class="font-mono-draft text-sm uppercase tracking-wider mb-2">Empezás acá</p>}
                  <h3 class="text-2xl sm:text-3xl font-bold tracking-tight mb-2">
                    <span class="sr-only">Paso {s.n}: </span>{s.title}
                  </h3>
                  <p class="text-xl text-[#4D4D4D] leading-snug">{s.desc}</p>
                  {s.missing && (
                    <p class="mt-3 inline-block rounded bg-yellow-200 px-2 py-1 text-base font-semibold text-black">[{s.missing}]</p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  </main>
</Draft>
