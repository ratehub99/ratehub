---
// Propuesta 1 (recomendada): "Claro y de confianza". BORRADOR generado con IA.
import Draft from '../../layouts/Draft.astro';
import WhatsAppCta from '../../components/draft/WhatsAppCta.astro';
import { steps } from '../../data/draft';
---

<Draft title="Propuesta 1 · Claro y de confianza — RateHub" bodyClass="bg-[#FAF8F4] text-[#14202B] font-sans-draft text-lg leading-relaxed antialiased">
  <header class="max-w-6xl mx-auto px-5 sm:px-8 py-6 flex items-center justify-between">
    <a href="/propuestas" class="font-serif-draft text-2xl font-bold tracking-tight">RateHub</a>
    <WhatsAppCta
      label="WhatsApp"
      class="hidden sm:inline-flex items-center gap-2 min-h-[48px] px-5 rounded-lg border-2 border-[#0F6B4A] text-[#0F6B4A] font-semibold hover:bg-[#0F6B4A] hover:text-white transition-colors"
    />
  </header>

  <main>
    <!-- HERO -->
    <section class="max-w-6xl mx-auto px-5 sm:px-8 pt-10 pb-20 sm:pt-16 sm:pb-28 grid lg:grid-cols-[1.25fr_1fr] gap-12 lg:gap-16 items-center">
      <div>
        <p class="text-base font-semibold text-[#0F6B4A] mb-5">
          Estudio de diseño y desarrollo web · Argentina
        </p>
        <h1 class="font-serif-draft text-[2.5rem] sm:text-6xl font-bold leading-[1.08] tracking-tight mb-6">
          Un sitio web conectado a tu negocio, no un folleto en internet.
        </h1>
        <p class="text-xl text-[#3A4753] mb-10 max-w-xl">
          Somos un equipo de diseño y marketing con base técnica en datos. Empezamos por tu sitio y, si lo necesitás, seguimos paso a paso: medir, ordenar y automatizar.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 sm:items-center">
          <WhatsAppCta
            class="inline-flex items-center justify-center gap-3 min-h-[60px] px-8 rounded-xl bg-[#0F6B4A] hover:bg-[#0B5A3E] text-white text-xl font-semibold transition-colors focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-[#0F6B4A]"
          />
          <a href="#camino" class="inline-flex items-center justify-center min-h-[60px] px-4 text-xl font-semibold underline underline-offset-4 decoration-2 hover:text-[#0F6B4A]">
            Ver cómo trabajamos
          </a>
        </div>
        <p class="mt-5 text-base text-[#3A4753]">Contanos de tu negocio y vemos si podemos ayudarte.</p>
      </div>

      <!-- Diagrama: el sitio como centro conectado -->
      <figure class="bg-white border border-[#D9D3C7] rounded-2xl p-6 sm:p-8">
        <svg viewBox="0 0 360 300" class="w-full h-auto" role="img" aria-labelledby="diag-t">
          <title id="diag-t">Tu sitio en el centro, conectado a medición, gestión comercial y automatización</title>
          <g stroke="#0F6B4A" stroke-width="2" fill="none">
            <path d="M180 120 V70" /><path d="M180 180 V230" />
            <path d="M120 150 H60" /><path d="M240 150 H300" />
          </g>
          <rect x="105" y="115" width="150" height="70" rx="12" fill="#0F6B4A" />
          <text x="180" y="157" text-anchor="middle" font-size="22" font-weight="700" fill="#fff" font-family="Georgia, serif">Tu sitio</text>
          <g font-size="16" font-weight="600" fill="#14202B" text-anchor="middle" font-family="system-ui, sans-serif">
            <rect x="110" y="20" width="140" height="48" rx="10" fill="#FAF8F4" stroke="#D9D3C7" /><text x="180" y="50">Medición</text>
            <rect x="110" y="232" width="140" height="48" rx="10" fill="#FAF8F4" stroke="#D9D3C7" /><text x="180" y="262">Automatización</text>
            <rect x="2" y="126" width="58" height="48" rx="10" fill="#FAF8F4" stroke="#D9D3C7" /><text x="31" y="156" font-size="14">CRM</text>
            <rect x="300" y="126" width="58" height="48" rx="10" fill="#FAF8F4" stroke="#D9D3C7" /><text x="329" y="156" font-size="14">Email</text>
          </g>
        </svg>
        <figcaption class="mt-4 text-base text-[#3A4753]">El sitio nace conectado: no queda como una pieza aislada.</figcaption>
      </figure>
    </section>

    <!-- SERVICIOS: escalera como camino -->
    <section id="camino" class="bg-white border-t border-[#D9D3C7] scroll-mt-4">
      <div class="max-w-4xl mx-auto px-5 sm:px-8 py-20 sm:py-28">
        <h2 class="font-serif-draft text-4xl sm:text-5xl font-bold leading-tight tracking-tight mb-4">
          Un camino, paso a paso
        </h2>
        <p class="text-xl text-[#3A4753] mb-14 max-w-2xl">
          Empezás por el sitio y sumás lo que tu negocio necesite, cuando lo necesite.
        </p>

        <ol class="relative border-l-4 border-[#0F6B4A]/25 ml-5 sm:ml-6 space-y-10">
          {steps.map((s, i) => (
            <li class="relative pl-10 sm:pl-14">
              <span class="absolute -left-[26px] top-0 w-12 h-12 rounded-full bg-[#0F6B4A] text-white font-serif-draft text-2xl font-bold flex items-center justify-center ring-8 ring-white">
                {s.n}
              </span>
              {i === 0 && <p class="text-base font-semibold text-[#0F6B4A] mb-1">Empezás acá</p>}
              <h3 class="font-serif-draft text-2xl sm:text-3xl font-bold mb-2">{s.title}</h3>
              <p class="text-xl text-[#3A4753] max-w-2xl">{s.desc}</p>
              {s.missing && (
                <p class="mt-3 inline-block rounded bg-yellow-200 px-2 py-1 text-base font-semibold text-black">[{s.missing}]</p>
              )}
            </li>
          ))}
        </ol>

        <div class="mt-16 rounded-2xl bg-[#FAF8F4] border border-[#D9D3C7] p-6 sm:p-8 flex flex-col sm:flex-row gap-6 sm:items-center sm:justify-between">
          <p class="text-xl font-semibold max-w-md">¿No sabés por dónde empezar? Contanos qué hacés y lo vemos juntos.</p>
          <WhatsAppCta
            class="inline-flex items-center justify-center gap-3 min-h-[60px] px-8 rounded-xl bg-[#0F6B4A] hover:bg-[#0B5A3E] text-white text-xl font-semibold transition-colors focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-[#0F6B4A]"
          />
        </div>
      </div>
    </section>
  </main>
</Draft>
