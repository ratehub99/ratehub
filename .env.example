# Copiar a .env (local, no se commitea) y completar. En producción se cargan en Vercel.
# Nunca poner valores reales en este archivo.

# Resend: API key con permiso solo de envío.
RESEND_API_KEY=
# Cloudflare Turnstile: secret key del widget (servidor).
TURNSTILE_SECRET_KEY=
# Cloudflare Turnstile: site key del widget (pública, única con prefijo PUBLIC_).
PUBLIC_TURNSTILE_SITE_KEY=
# Casilla de RateHub que recibe las consultas.
CONTACT_TO_EMAIL=
# Remitente: debe ser del dominio/subdominio verificado en Resend.
CONTACT_FROM_EMAIL=
